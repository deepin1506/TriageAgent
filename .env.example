# Copy to .env (never commit .env).

# --- Mock ServiceNow: the mock API and the agent's client both read these ---
SNOW_BASE_URL=http://127.0.0.1:8080
SNOW_USERNAME=triage.agent
SNOW_PASSWORD=change-me
# Optional. If set, the mock also accepts "Authorization: Bearer <token>" and the client prefers it.
SNOW_TOKEN=

# --- Mock-only ---
SNOW_MOCK_DB=data/snow.db
# Exposes /_mock/* (fault injection, reset, request log). Set false on any public deploy.
SNOW_MOCK_ADMIN=true
# Chaos mode: fraction of /api/now requests that randomly get a 503 + Retry-After (0 = off).
SNOW_MOCK_FAULT_RATE=0

# --- LLM (wired up in Phase 2) ---
LLM_PROVIDER=gemini
# Set to the Flash model you use in Drilldown (check ai.google.dev for current model IDs).
LLM_MODEL=
GEMINI_API_KEY=
# Empty = provider default. Measure lower values in evals before committing to one.
LLM_TEMPERATURE=
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2

# Azure OpenAI: set LLM_PROVIDER=azure_openai and fill these instead.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT=

# --- Agent local state ---
CHECKPOINT_DB=data/checkpoints.db
RUN_LOG=runs/runs.jsonl
